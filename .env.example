# Database
# PostgreSQL connection string for Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/postpilot?schema=public"

# Supabase Auth
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable__your-key-here"

# TikTok for Developers
# Get these from https://developers.tiktok.com/dashboard
# Make sure to register a Redirect URI in TikTok Developer Portal matching TIKTOK_REDIRECT_URI
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://postpilot-ai-theta.vercel.app/api/tiktok/callback
